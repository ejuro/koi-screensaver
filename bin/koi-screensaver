#!/bin/bash

# Open the koi fullscreen on every monitor, the way
# omarchy-launch-screensaver opens its text effects: the same window class, so
# Omarchy's fullscreen rule, idle service and lock screen all treat it as the
# screensaver.

# Use the program built for this machine, shipped next to this script.
here=$(dirname "$(readlink -f "$0")")
pond="$here/koi-screensaver-$(uname -m)"
[[ -x $pond ]] || pond=$(command -v koi-screensaver) || {
  omarchy-notification-send -g 󰈺 "Koi Screensaver has no build for $(uname -m)" 2>/dev/null
  exit 1
}

# One screensaver at a time
pgrep -f '[o]rg.omarchy.screensaver' >/dev/null && exit 0

focused=$(omarchy-hyprland-monitor-focused)
terminal=$(xdg-terminal-exec --print-id)

case $terminal in
*Alacritty* | *ghostty* | *foot* | *kitty*) ;;
*)
  omarchy-notification-send -g 󰈺 "Koi Screensaver only runs in Alacritty, Foot, Ghostty, or Kitty" 2>/dev/null
  exit 1
  ;;
esac

# A smaller font than Omarchy's 18 gives the pond finer pixels; the koi keep
# their size on screen and are just drawn more smoothly.
font=${KOI_SCREENSAVER_FONT_SIZE:-4.5}

# Which scene: the pond, or the koi chase. Chosen in the bar panel, which
# keeps it in the plugin's state; KOI_SCREENSAVER_SCENE overrides it.
scene=${KOI_SCREENSAVER_SCENE:-$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/koi-screensaver/scene" 2>/dev/null)}
[[ $scene == chase ]] || scene=pond

# Frames per second, always a whole fraction of the monitor's refresh rate,
# so every frame lasts the same number of refreshes and the koi move evenly.
# Motion "balanced" (the default) takes as many as fit under 18, which keeps
# it no heavier than Omarchy's own screensaver (17.1 at 120 Hz, 15 at 60 Hz);
# "smooth" takes about 20 (20 at 60 and 120 Hz), for more CPU. Chosen in the
# bar drawer; KOI_SCREENSAVER_MOTION or KOI_SCREENSAVER_FPS override it.
motion=${KOI_SCREENSAVER_MOTION:-$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/koi-screensaver/motion" 2>/dev/null)}
[[ $motion == smooth ]] || motion=balanced
fps_for() {
  if [[ $KOI_SCREENSAVER_FPS =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    echo "$KOI_SCREENSAVER_FPS"
    return
  fi
  local hz
  hz=$(hyprctl monitors -j | jq -r --arg m "$1" '.[] | select(.name == $m) | .refreshRate')
  awk -v hz="${hz:-60}" -v motion="$motion" 'BEGIN {
    if (hz < 1) hz = 60
    if (motion == "smooth") { n = int(hz / 20); if (n < 1) n = 1 }
    else { n = int(hz / 18); if (n * 18 < hz) n++ }
    printf "%.4f\n", hz / n
  }'
}

hypr_focus_monitor() {
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1 || hyprctl dispatch focusmonitor "$1" >/dev/null
}

hypr_exec() {
  local command
  printf -v command '%q ' "$@"
  hyprctl dispatch "hl.dsp.exec_cmd([[$command]])" >/dev/null 2>&1 || hyprctl dispatch exec -- "bash -lc $(printf %q "$command")" >/dev/null
}

# Listen for the new window before opening it, so a fast terminal can't map
# before we're watching.
SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
exec {events}< <(socat -U - "UNIX-CONNECT:$SOCKET" 2>/dev/null)

wait_for_screensaver_window() {
  local line deadline=$((SECONDS + 5))
  while ((SECONDS < deadline)) && IFS= read -r -t $((deadline - SECONDS)) -u "$events" line; do
    [[ $line == openwindow\>\>*,org.omarchy.screensaver,* ]] && return 0
  done
}

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hypr_focus_monitor "$m"
  fps=$(fps_for "$m")

  case $terminal in
  *Alacritty*)
    hypr_exec alacritty --class=org.omarchy.screensaver --config-file "$OMARCHY_PATH/default/alacritty/screensaver.toml" -o "font.size=$font" -e "$pond" --screensaver --scene "$scene" --fps "$fps"
    ;;
  *foot*)
    hypr_exec foot --app-id=org.omarchy.screensaver --config="$OMARCHY_PATH/default/foot/screensaver.ini" --font="monospace:size=$font" -e "$pond" --screensaver --scene "$scene" --fps "$fps"
    ;;
  *kitty*)
    hypr_exec kitty --class=org.omarchy.screensaver --override font_size=$font --override window_padding_width=0 -e "$pond" --screensaver --scene "$scene" --fps "$fps"
    ;;
  *ghostty*)
    hypr_exec ghostty --class=org.omarchy.screensaver --config-file="$OMARCHY_PATH/default/ghostty/screensaver" --font-size="$font" -e "$pond" --screensaver --scene "$scene" --fps "$fps"
    ;;
  esac

  wait_for_screensaver_window
done

hypr_focus_monitor "$focused"
